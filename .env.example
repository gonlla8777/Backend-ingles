# EchoFlow Backend Configuration
APP_ENV=development
CORS_ORIGINS=["http://localhost:3000","http://localhost:8080","http://127.0.0.1:8080","*"]

# Google Gemini API (Free Tier - Google AI Studio)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# YouTube Proxy (Webshare o Proxy Residencial / Datacenter)
# Para evitar bloqueos de IP en plataformas de hosting cloud como Render:
YOUTUBE_PROXY_URL=http://username:password@proxy_host:proxy_port

# YouTube Transcript Extraction & Cookies
# En entornos cloud (Render, AWS, GCP) YouTube suele bloquear IPs de datacenters con:
# "YouTube is blocking requests from your IP. This usually is due to... IP belonging to a cloud provider".
# Solución técnica:
# 1. Configurar YOUTUBE_PROXY_URL con tu proxy de Webshare.
# 2. Opcionalmente configurar YOUTUBE_COOKIES_CONTENT con cookies Netscape exportadas.
# 3. Fallback educativo: si ENABLE_MOCK_FALLBACK=true, ante fallos imprevistos de red
#    se generará automáticamente una transcripción simulada de 6 oraciones (0s a 35s) con HTTP 200.
YOUTUBE_COOKIES_CONTENT=
ENABLE_MOCK_FALLBACK=true

# Pedagogical Segmentation Guardrails
SEGMENT_MIN_WORDS=4
SEGMENT_TARGET_MAX_WORDS=18
SEGMENT_HARD_MAX_WORDS=26
SEGMENT_MAX_DURATION_SECONDS=12.0
SEGMENT_ACOUSTIC_GAP_SECONDS=1.15
