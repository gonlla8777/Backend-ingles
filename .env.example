# EchoFlow Backend Configuration
APP_ENV=development
CORS_ORIGINS=["http://localhost:3000","http://localhost:8080","http://127.0.0.1:8080","*"]

# Google Gemini API (Free Tier - Google AI Studio)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# YouTube Transcript Extraction & Cookies
# En entornos cloud (Render, AWS, GCP) YouTube suele bloquear IPs por scraping anónimo.
# Opciones para resolverlo:
# 1. Copiar el texto completo de un 'cookies.txt' exportado desde el navegador en YOUTUBE_COOKIES_CONTENT.
#    (Recomendado para Render -> Environment Variables -> YOUTUBE_COOKIES_CONTENT).
# 2. O colocar un archivo físico 'cookies.txt' en la raíz de 'backend/'.
# 3. Fallback defensivo: si ALLOW_MOCK_FALLBACK=true, ante bloqueos de IP se devolverá automáticamente
#    un transcript educativo de demostración (entrevista laboral) para que la app continúe funcionando.
YOUTUBE_COOKIES_CONTENT=
ALLOW_MOCK_FALLBACK=true

# Pedagogical Segmentation Guardrails
SEGMENT_MIN_WORDS=4
SEGMENT_TARGET_MAX_WORDS=18
SEGMENT_HARD_MAX_WORDS=26
SEGMENT_MAX_DURATION_SECONDS=12.0
SEGMENT_ACOUSTIC_GAP_SECONDS=1.15
