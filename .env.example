# EchoFlow Backend Configuration
APP_ENV=development
CORS_ORIGINS=["http://localhost:3000","http://localhost:8080","http://127.0.0.1:8080","*"]

# Google Gemini API (Free Tier - Google AI Studio)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# YouTube Transcript Extraction & Cookies
# En entornos cloud (Render, AWS, GCP) YouTube suele bloquear IPs de datacenters con:
# "YouTube is blocking requests from your IP. This usually is due to... IP belonging to a cloud provider".
# Solución técnica:
# 1. Exporta tus cookies de YouTube en formato Netscape (archivo 'cookies.txt') usando una extensión como:
#    - "Get cookies.txt LOCALLY" (Chrome / Firefox / Edge) o "Cookie Editor".
# 2. En Render Dashboard -> Environment -> Environment Variables:
#    Agrega YOUTUBE_COOKIES_CONTENT y pega el texto completo del archivo cookies.txt.
# 3. O en desarrollo local, guarda el archivo como 'cookies.txt' en la raíz de 'backend/'.
# 4. Fallback educativo: si ENABLE_MOCK_FALLBACK=true, ante bloqueos de IP se generará automáticamente
#    una transcripción simulada de 6 oraciones de entrevista técnica (0s a 35s) con HTTP 200.
YOUTUBE_COOKIES_CONTENT=
ENABLE_MOCK_FALLBACK=true

# Pedagogical Segmentation Guardrails
SEGMENT_MIN_WORDS=4
SEGMENT_TARGET_MAX_WORDS=18
SEGMENT_HARD_MAX_WORDS=26
SEGMENT_MAX_DURATION_SECONDS=12.0
SEGMENT_ACOUSTIC_GAP_SECONDS=1.15
